# Base URL used by the browser for API calls.
# Local:      http://localhost:8080/api
# Production: /api  (requests go through the Next.js rewrite to the backend,
#                    so the refresh-token cookie stays first-party)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Backend origin that the /api and /uploads rewrites proxy to (next.config.ts).
# Production: https://<service>.onrender.com
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:8080

# Optional
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=
NEXT_PUBLIC_RETURN_WINDOW_DAYS=7

# NOTE: NEXT_PUBLIC_* values are inlined at build time; redeploy after changing them.
