# Copia este archivo como .env (en esta misma carpeta) y completa los valores.
# .env está en .gitignore: nunca subas tu token al repositorio.

# Nombre de la organización: lo que va después de https://dev.azure.com/
AZDO_ORG=tu-organizacion
# Nombre exacto del proyecto en Azure DevOps
AZDO_PROJECT=ACS 2026
# Token de acceso personal con scope Work Items (Read & write)
AZDO_PAT=

# Opcional. Proceso Agile = "User Story" (por defecto); proceso Scrum = "Product Backlog Item"
AZDO_REQUIREMENT_TYPE=User Story
# Opcional. Etiqueta que se agrega a todos los work items
AZDO_TAG=ACS2026-Fase1
