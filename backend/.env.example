PORT=8080
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
# Used only by src/scripts/seed.js (defaults to mongodb://127.0.0.1:27017/luxora).
# WARNING: the seed deletes ALL users and products before inserting demo data.
MONGO_URI=

# JWT
JWT_ACCESS_SECRET=replace_with_strong_secret
JWT_MFA_SECRET=replace_with_strong_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
MFA_CHALLENGE_TTL=5m

# CORS / Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Optional regex for dynamic origins, e.g. Vercel previews:
# CORS_ORIGIN_REGEX=^https://luxora-qa(-[a-z0-9-]+)?\.vercel\.app$
CORS_ORIGIN_REGEX=

# Proxy hops in front of the app (1 locally/direct, 2 behind Vercel rewrite + Render)
TRUST_PROXY=1

# Storage
STORAGE_MODE=local
MAX_UPLOAD_BYTES=20971520
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
EMAIL_PROVIDER=brevo
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Luxora
EMAIL_REPLY_TO=support@example.com
EMAIL_DISABLED=false

# Brevo API
BREVO_API_KEY=your_brevo_api_key

# Security / optional routes
ENABLE_TEST_EMAIL_ROUTE=false
HCAPTCHA_SECRET=

# Business config
TAX_RATE=0.05
RETURN_WINDOW_DAYS=7
